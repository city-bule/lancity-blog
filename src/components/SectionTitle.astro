---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="mb-7 max-w-2xl">
  {eyebrow && <p class="mb-2 text-sm font-semibold text-sky-600">{eyebrow}</p>}
  <h2 class="text-2xl font-semibold text-slate-900 sm:text-3xl">{title}</h2>
  {description && <p class="mt-3 text-base leading-8 text-slate-600">{description}</p>}
</div>

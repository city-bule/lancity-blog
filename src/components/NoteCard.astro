---
import TagList from "./TagList.astro";
import { formatDate } from "../lib/content";

interface Props {
  title: string;
  description: string;
  date: Date;
  category?: string;
  tags?: string[];
  url: string;
}

const { title, description, date, category, tags = [], url } = Astro.props;
---

<article class="flex h-full flex-col rounded-lg border border-sky-100 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-sky-200 hover:shadow-md">
  <div class="mb-4 flex flex-wrap items-center gap-2 text-xs font-medium text-slate-500">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    {category && <span class="rounded-full bg-violet-50 px-2.5 py-1 text-violet-700">{category}</span>}
  </div>
  <h3 class="text-lg font-semibold leading-7 text-slate-950">
    <a href={url} class="hover:text-sky-700">{title}</a>
  </h3>
  <p class="mt-3 flex-1 text-sm leading-7 text-slate-600">{description}</p>
  <div class="mt-5">
    <TagList tags={tags} />
  </div>
</article>

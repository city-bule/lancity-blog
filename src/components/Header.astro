---
const navItems = [
  { href: "/", label: "首页" },
  { href: "/notes/", label: "学习笔记" },
  { href: "/portfolio/", label: "作品集" },
  { href: "/about/", label: "关于我" },
  { href: "/contact/", label: "联系我" },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-sky-100/80 bg-white/88 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-5 py-3 sm:px-6">
    <a href="/" class="text-base font-semibold text-slate-950" aria-label="蓝city 首页">✦ 蓝city</a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="主导航">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "rounded-full px-3.5 py-2 text-sm font-medium transition",
              isActive(item.href)
                ? "bg-sky-100 text-sky-800"
                : "text-slate-600 hover:bg-slate-100 hover:text-slate-950",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <details class="relative md:hidden">
      <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-sky-100 bg-white text-xl text-slate-700 shadow-sm marker:hidden">
        <span aria-hidden="true">☰</span>
        <span class="sr-only">打开导航</span>
      </summary>
      <nav class="absolute right-0 mt-3 grid w-40 gap-1 rounded-lg border border-sky-100 bg-white p-2 shadow-lg" aria-label="移动端导航">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                "rounded-md px-3 py-2 text-sm font-medium",
                isActive(item.href)
                  ? "bg-sky-100 text-sky-800"
                  : "text-slate-600 hover:bg-slate-100 hover:text-slate-950",
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>

---
import { getCollection, render } from "astro:content";
import PortfolioLayout from "../../layouts/PortfolioLayout.astro";
import { byDateDesc, isPublished } from "../../lib/content";

export async function getStaticPaths() {
  const works = (await getCollection("portfolio")).filter(isPublished).sort(byDateDesc);

  return works.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      previous: works[index + 1],
      next: works[index - 1],
    },
  }));
}

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
---

<PortfolioLayout entry={entry} previous={previous} next={next}>
  <Content />
</PortfolioLayout>

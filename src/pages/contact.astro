---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
---

<BaseLayout title="联系我 | 蓝city" description="欢迎交流 AI 创作、视频制作、编程学习和博客搭建。">
  <main class="mx-auto max-w-5xl px-5 py-12 sm:px-6 sm:py-16">
    <SectionTitle
      eyebrow="Contact"
      title="联系我"
      description="欢迎交流 AI 创作、视频制作、编程学习和博客搭建。"
    />

    <div class="grid gap-4 md:grid-cols-3">
      <a href="mailto:hello@lancity.com" class="rounded-lg border border-sky-100 bg-white p-5 shadow-sm hover:border-sky-200">
        <span class="text-sm font-semibold text-sky-700">Email</span>
        <span class="mt-3 block text-base font-semibold text-slate-950">hello@lancity.com</span>
        <span class="mt-2 block text-sm leading-6 text-slate-500">适合发送合作、交流和项目问题。</span>
      </a>
      <a href="/notes/" class="rounded-lg border border-sky-100 bg-white p-5 shadow-sm hover:border-sky-200">
        <span class="text-sm font-semibold text-teal-700">Notes</span>
        <span class="mt-3 block text-base font-semibold text-slate-950">学习笔记</span>
        <span class="mt-2 block text-sm leading-6 text-slate-500">查看 AI、编程和影像表达记录。</span>
      </a>
      <a href="/portfolio/" class="rounded-lg border border-sky-100 bg-white p-5 shadow-sm hover:border-sky-200">
        <span class="text-sm font-semibold text-violet-700">Works</span>
        <span class="mt-3 block text-base font-semibold text-slate-950">作品集</span>
        <span class="mt-2 block text-sm leading-6 text-slate-500">浏览 AI 绘图、AI 视频和分镜练习。</span>
      </a>
    </div>
  </main>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionTitle from "../../components/SectionTitle.astro";

const profileItems = [
  { label: "姓名", value: "吴深波" },
  { label: "性别", value: "男" },
  { label: "籍贯", value: "贵州" },
  { label: "大学", value: "中南名字大学" },
  { label: "专业", value: "光电信息科学与工程" },
  { label: "入学年份", value: "2022年" },
];

const projects = [
  {
    title: "AI绘画的实际应用",
    description:
      "较早接触AI绘画，在2024年与老师做项目，主要研究Stable Diffusion图像生成模型的应用，主要研究AI绘画提示词和炼制lora模型。" +
      "负责AI训练数据的收集及标注，利用开源工具和自定义脚本清洗、预处理数据集，确保高质量的数据输入。",
    tags: ["AI绘画", "提示词设计", "模型训练"],
  },
  {
    title: "校园经历",
    description:
      "组织前程无忧秋招求职训练营的校园宣讲活动，进行线上线下多渠道宣传。"+
      "协调与安排讲座：与职场指导导师紧密合作，精心策划并实施了多场专题讲座。",
    tags: ["校园活动", "组织协调", "宣传策划"],
  },
  {
    title: "AI 绘图与分镜练习",
    description:
      "随着AI工具的越来越强大，我觉得一些个人的审美和表达越来越重要，现在正在学习视觉风格、构图和分镜设计，把零散练习整理成可复用的创作方法。",
    tags: ["AI 绘图", "分镜", "视觉表达"],
  },
];

const interests = [
  "AI 绘图",
  "AI 视频",
  "提示词设计",
  "分镜与构图",
];
---

<BaseLayout title="个人详细信息 | 蓝city" description="蓝city 的个人信息、学习方向和项目经历。">
  <main class="mx-auto max-w-5xl px-5 py-12 sm:px-6 sm:py-16">
    <a
      href="/about/"
      class="mb-8 inline-flex items-center gap-2 text-sm font-semibold text-sky-700 hover:text-sky-900"
    >
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M19 12H6"></path>
        <path d="m10 18-6-6 6-6"></path>
      </svg>
      返回关于我
    </a>

    <SectionTitle
      eyebrow="Profile"
      title="个人详细信息"
      description="这里记录我的基本信息、学习方向和正在持续完善的项目经历。"
    />

    <section class="grid gap-6 md:grid-cols-[0.8fr_1.2fr]">
      <div class="overflow-hidden rounded-lg border border-sky-100 bg-white shadow-sm">
        <img
          src="/images/site/hero-lancity.png"
          alt="蓝city 学习空间"
          class="aspect-[4/3] w-full object-cover"
        />
        <div class="p-5">
          <p class="text-sm font-semibold text-sky-700">About Me</p>
          <h2 class="mt-2 text-xl font-semibold text-slate-950">你好，我是蓝city。</h2>
          <p class="mt-3 text-sm leading-7 text-slate-600">
            我正在学习如何把 AI 创作和影像表达结合起来，并通过持续记录让每一次练习都留下可回顾的过程。
          </p>
        </div>
      </div>

      <div class="rounded-lg border border-sky-100 bg-white p-5 shadow-sm sm:p-6">
        <h2 class="text-lg font-semibold text-slate-950">基本信息</h2>
        <dl class="mt-5 grid gap-3 sm:grid-cols-2">
          {
            profileItems.map((item) => (
              <div class="rounded-lg bg-sky-50 px-4 py-3">
                <dt class="text-xs font-semibold uppercase tracking-wide text-sky-700">{item.label}</dt>
                <dd class="mt-1.5 text-sm font-medium leading-6 text-slate-800">{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="mt-12">
      <SectionTitle
        eyebrow="Projects"
        title="项目经历"
        description="这是我的一些相关的项目经历和我现阶段的学习重点，也会随着新的实践持续更新。"
      />
      <div class="grid gap-4 md:grid-cols-3">
        {
          projects.map((project) => (
            <article class="rounded-lg border border-sky-100 bg-white p-5 shadow-sm">
              <h3 class="text-lg font-semibold text-slate-950">{project.title}</h3>
              <p class="mt-3 text-sm leading-7 text-slate-600">{project.description}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <span class="rounded-full bg-sky-50 px-3 py-1 text-xs font-medium text-sky-700">{tag}</span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mt-12 grid gap-4 md:grid-cols-[1.2fr_0.8fr]">
      <div class="rounded-lg border border-sky-100 bg-white p-5 shadow-sm sm:p-6">
        <p class="text-sm font-semibold text-sky-700">Learning Path</p>
        <h2 class="mt-2 text-lg font-semibold text-slate-950">学习与成长</h2>
        <p class="mt-3 text-sm leading-7 text-slate-600">
          我希望逐步建立自己的创作方法：从理解工具开始，在实际练习中发现问题，再通过复盘总结可复用的经验。这个页面也会随着学习进度继续补充。
        </p>
      </div>

      <div class="rounded-lg border border-sky-100 bg-white p-5 shadow-sm sm:p-6">
        <p class="text-sm font-semibold text-sky-700">Interests</p>
        <h2 class="mt-2 text-lg font-semibold text-slate-950">关注方向</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {
            interests.map((interest) => (
              <span class="rounded-full bg-slate-100 px-3 py-1.5 text-sm text-slate-700">{interest}</span>
            ))
          }
        </div>
      </div>
    </section>

    <div class="mt-12 flex justify-end border-t border-sky-100 pt-7">
      <a
        href="/contact/"
        class="group flex items-center gap-4 text-right"
        aria-label="前往联系我页面"
      >
        <span>
          <span class="block text-sm font-semibold text-sky-700">Contact</span>
          <span class="mt-1 block text-base font-semibold text-slate-900">继续前往联系我</span>
        </span>
        <span class="flex h-12 w-12 items-center justify-center rounded-full border border-sky-200 bg-white text-sky-700 shadow-sm transition group-hover:border-sky-400 group-hover:bg-sky-100 group-hover:text-sky-900">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h13"></path>
            <path d="m14 6 6 6-6 6"></path>
          </svg>
        </span>
      </a>
    </div>
  </main>
</BaseLayout>

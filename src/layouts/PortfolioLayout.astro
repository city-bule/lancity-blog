---
import BaseLayout from "./BaseLayout.astro";
import TagList from "../components/TagList.astro";
import { formatDate, getEntryUrl } from "../lib/content";

const { entry, previous, next } = Astro.props as any;
const data = entry.data;
---

<BaseLayout title={`${data.title} | 蓝city`} description={data.description}>
  <main class="mx-auto max-w-3xl px-5 py-10 sm:px-6 sm:py-14">
    <a href="/portfolio/" class="text-sm font-medium text-sky-700 hover:text-sky-900">← 返回作品集</a>

    <article class="mt-7">
      <header class="border-b border-sky-100 pb-8">
        <p class="mb-3 text-sm font-semibold text-sky-600">作品集</p>
        <h1 class="text-3xl font-semibold leading-tight text-slate-950 sm:text-5xl">{data.title}</h1>
        <p class="mt-5 text-lg leading-8 text-slate-600">{data.description}</p>
        <div class="mt-5 flex flex-wrap items-center gap-3 text-sm text-slate-500">
          <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
          <span class="rounded-full bg-teal-50 px-3 py-1 text-teal-700">{data.type}</span>
        </div>
        {
          data.tools?.length > 0 && (
            <p class="mt-4 text-sm leading-7 text-slate-500">使用工具：{data.tools.join("、")}</p>
          )
        }
        <div class="mt-5">
          <TagList tags={data.tags} />
        </div>
      </header>

      {
        data.cover && (
          <img
            src={data.cover}
            alt={`${data.title} 封面`}
            class="mt-8 aspect-[16/9] w-full rounded-lg border border-sky-100 object-cover shadow-sm"
            loading="eager"
          />
        )
      }

      {
        data.video && (
          <a href={data.video} class="mt-6 inline-flex rounded-full bg-sky-500 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-600">
            打开视频链接
          </a>
        )
      }

      <div class="article-content mt-9">
        <slot />
      </div>
    </article>

    {
      (previous || next) && (
        <nav class="mt-12 grid gap-3 border-t border-sky-100 pt-6 sm:grid-cols-2" aria-label="相邻作品">
          {previous ? (
            <a href={getEntryUrl("portfolio", previous.id)} class="rounded-lg border border-sky-100 bg-white p-4 shadow-sm hover:border-sky-200">
              <span class="text-xs font-medium text-slate-500">上一篇</span>
              <span class="mt-2 block text-sm font-semibold leading-6 text-slate-900">{previous.data.title}</span>
            </a>
          ) : (
            <span></span>
          )}
          {next && (
            <a href={getEntryUrl("portfolio", next.id)} class="rounded-lg border border-sky-100 bg-white p-4 shadow-sm hover:border-sky-200 sm:text-right">
              <span class="text-xs font-medium text-slate-500">下一篇</span>
              <span class="mt-2 block text-sm font-semibold leading-6 text-slate-900">{next.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </main>
</BaseLayout>
